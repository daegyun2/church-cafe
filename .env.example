# Supabase 연결 정보 (Supabase 대시보드 -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 선교카페 계좌 안내 설정 (선택사항 - 미입력 시 기본값 사용)
NEXT_PUBLIC_CAFE_BANK_NAME=카카오뱅크
NEXT_PUBLIC_CAFE_ACCOUNT_NUMBER=3333-01-2345678
NEXT_PUBLIC_CAFE_ACCOUNT_HOLDER=선교카페(홍길동)

# 관리자(/admin) 정산 화면 4자리 PIN 번호 (기본값: 1234)
NEXT_PUBLIC_ADMIN_PIN=1234
